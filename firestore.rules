rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isAgent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/agents/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.active == true;
    }
    function agentRole() {
      return get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.role;
    }
    function hasRole(role) { return isAgent() && agentRole() == role; }
    function canManageClients() { return isAgent() && agentRole() in ['admin','case_manager']; }
    function canReviewDocs() { return isAgent() && agentRole() in ['admin','case_manager','document_reviewer','compliance_officer']; }
    function canHandleEnquiries() { return isAgent() && agentRole() in ['admin','case_manager','customer_service','compliance_officer','enquiry_handler']; }

    match /enquiries/{docId} {
      allow create: if true;
      allow read, update: if canHandleEnquiries();
      allow delete: if hasRole('admin');
    }
    match /agents/{uid} {
      allow read: if isOwner(uid) || (isSignedIn() && (exists(/databases/$(database)/documents/agents/$(request.auth.uid)) || exists(/databases/$(database)/documents/agents/$(request.auth.token.email))));
      // Admin can write any agent doc; agents can update their own profile only
      allow write: if hasRole('admin') || isOwner(uid);
    }
    match /clients/{uid} {
      allow read: if isOwner(uid) || isAgent();
      allow write: if isOwner(uid) || canManageClients();
    }
    match /clients/{uid}/family/{memberId} {
      allow read: if isOwner(uid) || isAgent();
      allow write: if isOwner(uid) || canManageClients();
    }
    match /cases/{uid} {
      allow read: if isOwner(uid) || isAgent();
      allow write: if canManageClients();
    }
    match /documents/{uid}/files/{docId} {
      allow read: if isOwner(uid) || isAgent();
      allow create: if isOwner(uid);
      allow update: if canReviewDocs();
      allow delete: if hasRole('admin');
    }
    match /messages/{uid}/thread/{msgId} {
      allow read: if isOwner(uid) || isAgent();
      allow create: if isOwner(uid) || isAgent();
      allow update: if isOwner(uid) || isAgent();
    }
    match /invoices/{uid}/items/{invId} {
      allow read: if isOwner(uid) || isAgent();
      allow write: if canManageClients();
    }
    match /reports/{reportId} {
      allow read, create: if isAgent();
      allow update, delete: if hasRole('admin');
    }
    match /followups/{followupId} {
      allow read, create, update: if isAgent();
      allow delete: if hasRole('admin');
    }
    // ── Tickets ───────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isAgent() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAgent() || (isSignedIn() && resource.data.clientUid == request.auth.uid);
    }
    match /tickets/{ticketId}/messages/{msgId} {
      allow read: if isAgent() || (isSignedIn() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.clientUid == request.auth.uid);
      allow create: if isAgent() || (isSignedIn() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.clientUid == request.auth.uid);
    }

    match /notifications/{uid}/items/{notifId} {
      allow read, update: if isOwner(uid);
      allow create: if isAgent();
      allow delete: if isOwner(uid) || isAgent();
    }

    // ── Notifications (flat structure) ─────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ── Consultation Bookings ─────────────────────────────────────────
    match /consultation_bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.clientUid == request.auth.uid || resource.data.consultantUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.clientUid == request.auth.uid || resource.data.consultantUid == request.auth.uid);
      allow delete: if hasRole('admin');
    }

    // ── Consultant Availability ──────────────────────────────────────
    match /consultant_availability/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == request.resource.data.consultantUid || hasRole('admin'));
      allow delete: if hasRole('admin') || isOwner(request.resource.data.consultantUid);
    }

    // ── Consultant Activities (Audit Log) ────────────────────────────
    match /consultant_activities/{activityId} {
      allow read: if hasRole('admin') || (isSignedIn() && resource.data.consultantUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if hasRole('admin');
    }

    // ── Users collection ─────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || hasRole('admin');
      allow create: if hasRole('admin');
      allow update: if isOwner(uid) || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // ── User Activity logging ────────────────────────────────────────
    match /user_activity/{docId} {
      allow create: if isAgent();
      allow read: if hasRole('admin');
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // ── Role History ─────────────────────────────────────────────────
    match /role_history/{docId} {
      allow create: if hasRole('admin');
      allow read: if hasRole('admin');
      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // ── Password Reset Tokens ────────────────────────────────────────
    match /password_reset_tokens/{tokenHash} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
