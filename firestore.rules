rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
        || (
          request.auth.token.email != null
          && request.auth.token.email in [
            'desivo.de@gmail.com',
            'techmazewebdesign@gmail.com',
            'sara.rezai9031@gmail.com'
          ]
        )
      );
    }

    function isCustomerService() {
      return isSignedIn() && request.auth.token.role == 'customer-service';
    }

    function isConsultant() {
      return isSignedIn() && request.auth.token.role == 'consultant';
    }

    function isClient() {
      return isSignedIn() && request.auth.token.email != null;
    }

    // ========== USERS COLLECTION ==========
    match /users/{userId} {
      // Admins can read/write all users
      allow read, write: if isAdmin();

      // Users can read/write their own document
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ========== CLIENT PORTAL DATA ==========
    // Portal records are partitioned by Firebase UID. A client can access only
    // their own workspace; administrators retain operational access.
    match /clients/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /family/{memberId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /cases/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /messages/{userId}/thread/{messageId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.from == 'client';
      allow update, delete: if isAdmin();
    }

    match /invoices/{userId}/items/{invoiceId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /documents/{userId}/files/{documentId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.clientUid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.clientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadClient', 'unreadAgent', 'updatedAt', 'status']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isSignedIn()
            && get(/databases/$(database)/documents/tickets/$(ticketId)).data.clientUid == request.auth.uid);
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.clientUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.from == 'client';
        allow update, delete: if isAdmin();
      }
    }

    match /consultation_bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ========== CUSTOMER SERVICE PROFILES ==========
    match /customerServiceProfiles/{userId} {
      // Customer service can read/write their own profile
      allow read: if isCustomerService() && request.auth.uid == userId;
      allow write: if isCustomerService() && request.auth.uid == userId;

      // Admins can read/write all profiles
      allow read, write: if isAdmin();
    }

    // ========== SUPPORT TICKETS ==========
    match /supportTickets/{ticketId} {
      // Customer service can read tickets assigned to them
      allow read: if isCustomerService() && resource.data.assignedTo == request.auth.uid;

      // Customer service can update tickets assigned to them
      allow update: if isCustomerService() && resource.data.assignedTo == request.auth.uid;

      // Admins can read/write all tickets
      allow read, write: if isAdmin();
    }

    // ========== CUSTOMER SERVICE ACTIVITY LOG ==========
    match /customerServiceActivity/{activityId} {
      // Customer service can read their own activity log
      allow read: if isCustomerService() && resource.data.userId == request.auth.uid;

      // Customer service can create activity records for themselves
      allow create: if isCustomerService() && request.resource.data.userId == request.auth.uid;

      // Admins can read/write all activity
      allow read, write: if isAdmin();
    }

    // ========== BOOKINGS COLLECTION ==========
    match /bookings/{bookingId} {
      // Consultants can read bookings assigned to them
      allow read: if isConsultant() && resource.data.consultantId == request.auth.uid;

      // Customers can read their own bookings
      allow read: if isClient() && resource.data.clientEmail == request.auth.token.email;

      // Customer service can read bookings
      allow read: if isCustomerService();

      // Admins can read/write all bookings
      allow read, write: if isAdmin();

      // Anyone can create bookings (public form submissions)
      allow create: if true;
    }

    // ========== INQUIRIES COLLECTION ==========
    match /enquiries/{inquiryId} {
      // Consultants can read inquiries assigned to them
      allow read: if isConsultant() && resource.data.consultantId == request.auth.uid;

      // Customer service can read inquiries
      allow read: if isCustomerService();

      // Admins can read/write all inquiries
      allow read, write: if isAdmin();

      // Anyone can create inquiries (public form submissions)
      allow create: if true;
    }

    // ========== CONSULTANT PROFILES ==========
    match /consultants/{consultantId} {
      // Anyone can read consultant profiles (public)
      allow read: if true;

      // Consultants can write their own profile
      allow write: if isConsultant() && request.auth.uid == consultantId;

      // Admins can read/write all profiles
      allow read, write: if isAdmin();
    }

    // ========== CHAT SESSIONS (FAQ CHATBOT) ==========
    match /chatSessions/{sessionId} {
      // Customer service can read all chat sessions
      allow read: if isCustomerService();

      // Admins can read/write all sessions
      allow read, write: if isAdmin();

      // Anyone can create a session (public chatbot)
      allow create: if true;

      // Nested messages subcollection
      match /messages/{messageId} {
        // Customer service can read messages in sessions they can read
        allow read: if isCustomerService()
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.source == 'faq-chatbot';

        // Admins can read/write all messages
        allow read, write: if isAdmin();

        // API can create messages for any session
        allow create: if request.auth == null || isSignedIn();
      }
    }

    // ========== ADMIN FALLBACK / DEFAULT DENY ==========
    // Approved administrators manage several operational collections used by
    // the dashboard. Everyone else remains denied unless a narrower rule above
    // explicitly grants access.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
