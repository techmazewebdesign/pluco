rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========== HELPER FUNCTIONS ==========
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isConsultant() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.role == 'consultant';
    }

    function isBookingConsultant(bookingId) {
      return isConsultant() &&
             get(/databases/$(database)/documents/bookings/$(bookingId)).data.consultantId == request.auth.uid;
    }

    // ========== USERS COLLECTION ==========
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if isAdmin() || request.auth.uid == userId;
      allow create: if isSignedIn();
    }

    // ========== AGENTS/CONSULTANTS COLLECTION ==========
    match /agents/{agentId} {
      allow read: if isAdmin() || isConsultant() || request.auth.uid == agentId;
      allow write: if isAdmin() || request.auth.uid == agentId;
      allow create: if isAdmin();
    }

    // ========== CLIENTS COLLECTION ==========
    match /clients/{clientId} {
      allow read: if isAdmin() || request.auth.uid == clientId;
      allow write: if isAdmin() || request.auth.uid == clientId;
      allow create: if isSignedIn();
    }

    // ========== BOOKINGS COLLECTION (CRITICAL) ==========
    match /bookings/{bookingId} {
      // Anyone can CREATE a booking (public form submission)
      allow create: if true;

      // Admins can read/write all bookings
      allow read, update, delete: if isAdmin();

      // Consultants can read only their assigned bookings
      allow read: if isConsultant() && resource.data.consultantId == request.auth.uid;

      // Consultants can update only their assigned bookings
      allow update: if isConsultant() &&
                       resource.data.consultantId == request.auth.uid &&
                       request.resource.data.consultantId == resource.data.consultantId; // Can't change consultant
    }

    // ========== ENQUIRIES COLLECTION (LEGACY) ==========
    match /enquiries/{enquiryId} {
      // Anyone can CREATE an enquiry (legacy form)
      allow create: if true;

      // Admins can read/write all
      allow read, update, delete: if isAdmin();

      // Consultants can read their assigned ones
      allow read: if isConsultant() && resource.data.consultantId == request.auth.uid;

      allow update: if isConsultant() &&
                       resource.data.consultantId == request.auth.uid &&
                       request.resource.data.consultantId == resource.data.consultantId;
    }

    // ========== OTHER COLLECTIONS (RESTRICTIVE) ==========
    match /email_verifications/{doc=**} {
      allow write: if request.auth != null;
      allow read: if isAdmin();
    }

    match /cases/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /leads/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /notifications/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ========== DEFAULT DENY ==========
    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
