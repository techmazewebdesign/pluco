rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read all photos
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow users to upload and manage their own profile photos
    match /profiles/{uid}/photo.{extension=jpg|jpeg|png|webp} {
      allow write: if request.auth.uid == uid &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Allow users to upload and manage family member photos
    match /profiles/{uid}/family/{memberId}/photo.{extension=jpg|jpeg|png|webp} {
      allow write: if request.auth.uid == uid &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }

    // Allow agents to upload and manage their own photos
    match /agents/{uid}/photo.{extension=jpg|jpeg|png|webp} {
      allow write: if request.auth.uid == uid &&
                      request.resource.size < 5 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
    }
  }
}
